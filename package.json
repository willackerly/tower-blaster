{
  "name": "tower-blaster",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "codegen": "tsx packages/schema/src/cli.ts",
    "bench": "tsx packages/bench/src/cli.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "@webgpu/types": "0.1.74",
    "@tb/schema": "workspace:*",
    "@tb/scenarios": "workspace:*",
    "@tb/engine-api": "workspace:*",
    "@tb/adapter-rapier": "workspace:*",
    "@tb/metrics": "workspace:*",
    "@tb/bench": "workspace:*",
    "@tb/testkit": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
