{
  "name": "tower-blaster",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:durations": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report.json; tsx packages/testkit/src/durations-cli.ts --scale 1.4 .vitest-report.json",
    "durations": "tsx packages/testkit/src/durations-cli.ts",
    "ci:guard": "tsx packages/testkit/src/shard-guard.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "codegen": "tsx packages/schema/src/cli.ts",
    "bench": "tsx packages/bench/src/cli.ts",
    "check": "pnpm typecheck && pnpm test",
    "runner": "vite packages/runner",
    "bench:browser": "tsx packages/runner/src/cli.ts",
    "bench:suite": "tsx packages/runner/src/suite-cli.ts",
    "bench:gpu": "tsx packages/gpu/src/bench-cli.ts",
    "bench:probe": "tsx packages/physics-gpu/src/probe-cli.ts",
    "bench:probe-compare": "tsx packages/physics-gpu/src/probe-compare-cli.ts",
    "bench:quality": "tsx packages/physics-gpu/src/quality-cli.ts",
    "bench:render": "tsx packages/render/src/bench-cli.ts",
    "tiers:compare": "tsx packages/lattice/src/compare-cli.ts",
    "viewer": "vite packages/viewer",
    "keystone:probe": "tsx packages/keystone-lab/src/cli.ts",
    "keystone:bot": "tsx packages/keystone-lab/src/bot-cli.ts",
    "keystone:par": "tsx packages/keystone-lab/src/par-cli.ts",
    "keystone:stars": "tsx packages/keystone-lab/src/stars-audit-cli.ts",
    "keystone:cast": "tsx packages/keystone-lab/src/cast-cli.ts",
    "keystone:opener": "tsx packages/keystone-lab/src/opener-cli.ts",
    "keystone:goals": "tsx packages/keystone-lab/src/goals-cli.ts",
    "keystone:quake": "tsx packages/keystone-lab/src/quake-search-cli.ts",
    "keystone:quake-seed": "tsx packages/keystone-lab/src/quake-seed-cli.ts",
    "keystone:retrofit": "tsx packages/keystone-lab/src/retrofit-cli.ts",
    "keystone:fuse": "tsx packages/keystone-lab/src/fuse-search-cli.ts",
    "duel:bot": "tsx packages/game/src/duel-bot-cli.ts",
    "keystone:settle-study": "tsx packages/keystone-lab/src/settle-study-cli.ts",
    "rube:gate": "tsx packages/keystone-lab/src/rube-gate-cli.ts",
    "game": "vite packages/game",
    "playtest:build": "tsx packages/playtest/src/build.ts",
    "playtest:local": "tsx packages/playtest/src/local.ts",
    "playtest:deploy": "tsx packages/playtest/src/deploy.ts",
    "playtest:testers": "tsx packages/playtest/src/testers.ts",
    "playtest:smoke": "tsx packages/playtest/src/smoke.ts",
    "playtest:agent": "tsx packages/playtest/src/agent/run.ts",
    "probe:modes": "tsx packages/mode-probes/src/cli.ts",
    "mason:judge": "tsx packages/keystone-lab/src/mason-cli.ts"
  },
  "devDependencies": {
    "@tb/adapter-rapier": "workspace:*",
    "@tb/audio": "workspace:*",
    "@tb/bench": "workspace:*",
    "@tb/engine-api": "workspace:*",
    "@tb/game": "workspace:*",
    "@tb/geom": "workspace:*",
    "@tb/gpu": "workspace:*",
    "@tb/keystone": "workspace:*",
    "@tb/keystone-lab": "workspace:*",
    "@tb/lattice": "workspace:*",
    "@tb/metrics": "workspace:*",
    "@tb/mode-probes": "workspace:*",
    "@tb/physics-gpu": "workspace:*",
    "@tb/physics-ref": "workspace:*",
    "@tb/playtest": "workspace:*",
    "@tb/render": "workspace:*",
    "@tb/runner": "workspace:*",
    "@tb/scenarios": "workspace:*",
    "@tb/schema": "workspace:*",
    "@tb/testkit": "workspace:*",
    "@tb/viewer": "workspace:*",
    "@tb/weapons": "workspace:*",
    "@types/node": "22.20.5",
    "@webgpu/types": "0.1.74",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
